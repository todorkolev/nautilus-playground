# Binance API credentials
# Create API keys at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Account type: spot, margin, usdt_future, coin_future
BINANCE_ACCOUNT_TYPE=spot

# Set to true to use Binance Testnet (for testing without real funds)
# Note: You need to create separate API keys for the testnet at https://testnet.binance.vision/
BINANCE_TESTNET=false

# Set to true if using Binance US instead of global Binance
BINANCE_US=false

# Custom endpoints (optional)
# BINANCE_BASE_URL_HTTP=
# BINANCE_BASE_URL_WS=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

###

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...
